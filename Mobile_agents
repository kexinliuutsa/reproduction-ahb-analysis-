基础代码：def execute_action(action):
    """执行agent决定的动作"""
    if action['type'] == 'tap':
        x, y = int(action['x']), int(action['y'])
        subprocess.run(['adb', 'shell', 'input', 'tap', str(x), str(y)])
        print(f"执行tap: ({x}, {y})")
        
    elif action['type'] == 'swipe':
        x1,y1,x2,y2 = int(action['x1']),int(action['y1']),int(action['x2']),int(action['y2'])
        duration = int(action.get('duration', 500))
        subprocess.run(['adb', 'shell', 'input', 'swipe', 
                       str(x1), str(y1), str(x2), str(y2), str(duration)])
        print(f"执行swipe: ({x1},{y1})→({x2},{y2})")
        
    elif action['type'] == 'back':
        subprocess.run(['adb', 'shell', 'input', 'keyevent', '4'])
        print("执行back")
        
    elif action['type'] == 'home':
        subprocess.run(['adb', 'shell', 'input', 'keyevent', '3'])
        print("执行home")
        
    elif action['type'] == 'finished':
        print("任务完成")
        return True
    
    return False

print("execute_action已更新，现在重新跑任务...")

