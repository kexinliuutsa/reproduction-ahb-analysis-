task = "在哔哩哔哩里搜索'熊猫'，点击第一个视频"
history = []
max_steps = 8

print(f"=== Naive Agent 开始 ===")
print(f"任务: {task}\n")

for step in range(max_steps):
    print(f"\n第{step+1}步:")
    screenshot = take_screenshot()
    
    try:
        action = get_agent_action_vision(
            client_sf, screenshot, task, history, NAIVE_SYSTEM_PROMPT
        )
        history.append(action)
        done = execute_action(action)
        if done:
            print("任务完成！")
            break
    except Exception as e:
        print(f"错误: {e}")
        break
    
    time.sleep(2)

print("\n=== Naive Agent 结束 ===")
print(f"共执行{len(history)}步")

